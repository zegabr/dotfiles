#!/usr/bin/env bash
set -euo pipefail

# Ensure standard binaries, homebrew, and local bin are in PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

WS="${1:-}"

if [ -z "$WS" ]; then
    exit 0
fi

# Query AeroSpace for the window count on the target workspace
WINDOW_COUNT=$(aerospace list-windows --workspace "$WS" --count 2>/dev/null || echo "")
WINDOW_COUNT=$(echo "$WINDOW_COUNT" | tr -d '[:space:]')

# If the workspace is empty (0 windows), spawn the designated fixed app.
# `open -na <App> --args <flag>` launches a new process which, for apps that
# enforce a single instance (Chrome, kitty), simply asks the already-running
# instance to open a new window and exits; if the app isn't running, it starts it.
if [ "$WINDOW_COUNT" = "0" ]; then
    case "$WS" in
        1)  # Workspace 1 -> Google Chrome
            open -na "Google Chrome" --args --new-window
            ;;
        2)  # Workspace 2 -> iTerm2
            # iTerm2 is single-instance; when it's already running, ask it for a
            # new window via AppleScript instead of just re-activating it.
            if pgrep -xq iTerm2; then
                osascript -e 'tell application "iTerm" to create window with default profile' >/dev/null
            else
                open -a "iTerm"
            fi
            ;;
        3)  # Workspace 3 -> Google Chat PWA
            open -b com.google.Chrome.app.pommaclcbfghclhalboakcipcmmndhcj 2>/dev/null || open -a "Google Chat"
            ;;
        4)  # Workspace 4 -> Duckie PWA
            open -b com.google.Chrome.app.ahdfkjhgpgcbfkeoehapbdafbjlnpejh 2>/dev/null || open -a "Duckie"
            ;;
        5)  # Workspace 5 -> YouTube PWA
            open -b com.google.Chrome.app.agimnkijcaahngcdmfeangaknmldooml 2>/dev/null || open -a "YouTube"
            ;;
        *)  # Workspace 6 or others: unassigned
            ;;
    esac
fi
