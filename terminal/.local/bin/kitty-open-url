#!/usr/bin/env bash
# Opens a URL clicked in kitty (configured via `open_url_with` in kitty.conf).
#
# kitty's URL detector only strips a trailing ")" when the character right
# before the URL is "(" on the same row. For text like "(see http://cl/1234)",
# or when the "(" sits on the previous row (wrapped line, or tmux redrawing a
# long line as separate rows), the URL arrives here as "http://cl/1234)".
# Trim unbalanced trailing brackets and stray punctuation before opening.
set -euo pipefail

url="${1:-}"
[ -n "$url" ] || exit 0

count() { # count occurrences of character $1 in $url
    local s="${url//[^$1]/}"
    printf '%s' "${#s}"
}

while :; do
    case "$url" in
        *\))  if (( $(count ')') > $(count '(') )); then url="${url%)}"; continue; fi ;;
        *\])  if (( $(count ']') > $(count '[') )); then url="${url%]}"; continue; fi ;;
        *\})  if (( $(count '}') > $(count '{') )); then url="${url%\}}"; continue; fi ;;
        *[.,\;:!?\'\"])  url="${url%?}"; continue ;;
    esac
    break
done

if command -v open >/dev/null 2>&1; then
    exec open "$url"          # macOS
else
    exec xdg-open "$url"      # Linux
fi
