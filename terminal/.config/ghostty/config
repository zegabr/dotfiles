# ==============================================================================
# Ghostty Terminal Configuration (~/.config/ghostty/config)
# ==============================================================================
# Validate with:  ghostty +validate-config
# Reload with:    Cmd+Shift+, (or restart Ghostty)

# ------------------------------------------------------------------------------
# macOS Keyboard & Clipboard Integration
# ------------------------------------------------------------------------------
# Treat both Left and Right Option keys as Alt (for tmux M-* bindings, vim, etc.)
# Must be explicit: Ghostty only defaults this to true for the "U.S." layout,
# and this machine uses the "ABC" layout.
macos-option-as-alt = true

# Allow applications (tmux, Neovim, SSH via OSC 52) to read & write the OS
# clipboard without prompts
clipboard-read = allow
clipboard-write = allow

# Copy selection straight to the OS clipboard (not just the primary selection)
copy-on-select = clipboard

# Note: Cmd+C / Cmd+V (copy_to_clipboard / paste_from_clipboard) and
# Option+Left / Option+Right (Esc+b / Esc+f word navigation) are already
# Ghostty's macOS defaults, so they don't need to be re-declared here.

# ------------------------------------------------------------------------------
# Font & Window Appearance
# ------------------------------------------------------------------------------
font-family = Monaco
font-size = 12

# Clean window appearance for AeroSpace tiling
confirm-close-surface = false
macos-titlebar-style = tabs

# ------------------------------------------------------------------------------
# Theme
# ------------------------------------------------------------------------------
# Browse all built-in themes with a live preview:  ghostty +list-themes
# GitHub Dark High Contrast: near-black #0a0c10 background with the highest
# legibility of the built-in dark themes - text is 17.6:1 and every one of the
# 16 ANSI colours is >= 9.2:1 against the background (WCAG AAA), so coloured
# output (ls, git, diffs, vim) stays crisp.
# Any colour key placed after this line (background, foreground,
# palette = N=#rrggbb, ...) overrides the theme's value.
theme = GitHub Dark High Contrast
